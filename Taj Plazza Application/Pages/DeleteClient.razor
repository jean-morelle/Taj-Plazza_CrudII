@page "/DeleteClient/{id:int}"
@inherits DeleteClientComponent
<h3>Delete Client</h3>

<hr />
<div class="row">
    <div class="col-md-12">
        <EditForm Model="client" OnValidSubmit="DeleteClient" Forname="DeleteClient" OnInvalidSubmit="@HandleFailedRequest">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Nom complet</label>
                            <InputText for="NomComplet" class="form-control" @bind-Value="@client.NomComplete" />
                            <ValidationMessage For="()=>client.NomComplete" />
                        </div>
                        <div class="form-group">
                            <label class="control-label">Domicile</label>
                            <InputText for="NomComplet" class="form-control" @bind-Value="@client.Domicile" />
                            <ValidationMessage For="()=>client.Domicile" />
                        </div>
                        <div class="form-group">
                            <label class="control-label">Telephone</label>
                            <InputText for="NomComplet" class="form-control" @bind-Value="@client.Telephone" />
                            <ValidationMessage For="()=>client.Telephone" />
                        </div>
                        <div class="form-group">
                            <label class="control-label">Gmail</label>
                            <InputText for="Email" class="form-control" @bind-Value="@client.Email" />
                            <ValidationMessage For="()=>client.Email" />
                        </div>
                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary">Delete client</button>
                            <button type="submit" class="btn btn-danger">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>
