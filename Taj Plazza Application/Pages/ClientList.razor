 @page "/ClientList"
@inherits ClientListComponent

<div class="container">
  <div class="row">
        <p><a class="btn btn-success float-end" href="/AddNewClient"> Add new client</a></p>
    <div class="col-md-12">
        <div class="card">
        <div class="card-header"></div>
                @if (!getAllclients.Any())
                {
                    <p><em> Loading Clients ...</em></p>
                }
                @if(getAllclients.Any()){
        <div class="card-body">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom complet</th>
                <th>Domicile</th>
                <th>Telephone</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach ( var client in getAllclients)
            {
                <tr>
                    <td>
                       @client.Id
                    </td>
                    <td>
                        @client.NomComplete
                    </td>
                    <td>
                        @client.Domicile
                    </td>
                    <td>
                        @client.Telephone
                    </td>
                    <td>
                        @client.Email
                    </td>

                    <td>

                        <a href="/client/edit/@client.Id" class="btn btn-success ">Edit</a>
                        <a href="/client/delete/@client.Id" class="btn btn-danger ">Delete</a>
                    </td>
                    
                </tr>
            }
        </tbody>
       
    </table>
         </div>
                }
                else
                {
                  <div class="alert alert-info">There is not clients List Avalabre</div>  
                }
            </div>
<div/>
  </div>
</div>
</div>