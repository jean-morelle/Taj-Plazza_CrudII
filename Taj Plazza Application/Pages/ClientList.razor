@page "/ClientList"
@inherits ClientListComponent

<h3 class="text-primary text-center">Liste des clients</h3>

<div class="container mt-5 p-5">
    <div class="container text-lg-end"><button class="btn btn-primary" @onclick="() => null //DeleteClient(client.Id)">Ajout</button></div>
    <br />
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom complet</th>
                <th>Domicile</th>
                <th>Telephone</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach ( var client in clients)
            {
                <tr>
                    <td>
                       @client.Id
                    </td>
                    <td>
                        @client.NomComplete
                    </td>
                    <td>
                        @client.Domicile
                    </td>
                    <td>
                        @client.Telephone
                    </td>
                    <td>
                        @client.Email
                    </td>

                    <td>
                        
                        <button class="btn btn-success" @onclick="() => null //ShowEditClientForm(client)">Modifier</button>
                        <button class="btn btn-danger" @onclick="() => null //DeleteClient(client.Id)">Supprimer</button>
                    </td>
                    
                </tr>
            }
        </tbody>
    </table>
</div>
