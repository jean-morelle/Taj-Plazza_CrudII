@page "/ClientList"
@inherits ClientListComponent

<div class="container mt-5 p-5">
    <div class="container text-lg-end">
        <a href="@($"ClientDetails")" class="btn btn-success "> Ajouter un client</a>
        </div>
        <br />
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom complet</th>
                <th>Domicile</th>
                <th>Telephone</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach ( var client in clients)
            {
                <tr>
                    <td>
                       @client.Id
                    </td>
                    <td>
                        @client.NomComplete
                    </td>
                    <td>
                        @client.Domicile
                    </td>
                    <td>
                        @client.Telephone
                    </td>
                    <td>
                        @client.Email
                    </td>

                    <td>
                        <a href="@($"ClientDetais/")" class="btn btn-info">Modifier</a>
                        <a href="@($"ClientDetais/")" class="btn btn-danger">Supprimer</a>
                       
                    </td>
                    
                </tr>
            }
        </tbody>
    </table>
</div>
