@page "/EditClient/{id:int}"

@inherits EditClientComponent
<h3>Edit client</h3>

<hr />
<div class="row">
    <div class="col-md-12">
        <EditForm Model="client" OnValidSubmit="UpdateClient" OnInvalidSubmit="HandleFailedRequest">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Nom complet</label>
                            <InputText class="form-control" @bind-Value="client.NomComplete" />
                            <ValidationMessage For="@(() => client.NomComplete)" />
                        </div>
                        <div class="form-group">
                            <label class="control-label">Domicile</label>
                            <InputText class="form-control" @bind-Value="client.Domicile" />
                            <ValidationMessage For="@(() => client.Domicile)" />
                        </div>
                        <div class="form-group">
                            <label class="control-label">Téléphone</label>
                            <InputText class="form-control" @bind-Value="client.Telephone" />
                            <ValidationMessage For="@(() => client.Telephone)" />
                        </div>
                        <div class="form-group">
                            <label class="control-label">Email</label>
                            <InputText class="form-control" @bind-Value="client.Email" />
                            <ValidationMessage For="@(() => client.Email)" />
                        </div>
                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary">Update client</button>
                            <button type="button" class="btn btn-danger" @onclick="Cancel">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>
